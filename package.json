{
  "name": "controle-sst",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de Gestão Integrada de Saúde e Segurança do Trabalho (uso local, offline)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @sst/api dev",
    "dev:web": "pnpm --filter @sst/web dev",
    "db:migrate": "pnpm --filter @sst/api db:migrate"
  }
}
