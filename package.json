{
  "name": "controle-sst",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de Gest\u00e3o Integrada de Sa\u00fade e Seguran\u00e7a do Trabalho (uso local, offline)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @sst/shared build && pnpm --filter @sst/api build && pnpm --filter @sst/web build && pnpm --filter @sst/desktop build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @sst/api dev",
    "dev:web": "pnpm --filter @sst/web dev",
    "desktop": "pnpm build && pnpm --filter @sst/desktop exec electron .",
    "instalador:win": "pnpm build && pnpm --filter @sst/desktop dist:win",
    "db:migrate": "pnpm --filter @sst/api db:migrate"
  },
  "pnpm": {
    "overrides": {
      "@electron/node-gyp": "10.2.0-electron.2",
      "multer": "2.5.0",
      "exceljs>uuid": "11.1.1",
      "path-to-regexp@8": "8.4.2",
      "tar@^7": "7.5.22",
      "tinypool@^2": "2.2.0"
    }
  }
}
